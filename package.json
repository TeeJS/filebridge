{
  "name": "filebridge",
  "productName": "FileBridge",
  "version": "2.0.1",
  "private": true,
  "description": "Bring files together from folders, Google Drive, and subscription sites into local folders, on a schedule.",
  "main": "main.js",
  "author": "TeeJS",
  "license": "MIT",
  "engines": {
    "node": ">=18 <27"
  },
  "scripts": {
    "start": "node build-dpapi.js && electron .",
    "build:dpapi": "node build-dpapi.js",
    "test": "node test.js && node --test test/*.test.js",
    "dist": "node build-dpapi.js && electron-builder --win",
    "dist:win": "node build-dpapi.js && electron-builder --win",
    "dist:mac": "node build/mac-build.js",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.teejs.filebridge",
    "productName": "FileBridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "shell/*.js",
      "shell/native/filebridge_dpapi.node",
      "assets/icon.png",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png",
      "server.js",
      "status.js",
      "import.js",
      "sync.js",
      "drive.js",
      "web.js",
      "app.js",
      "index.html",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "signExts": [
        ".node"
      ],
      "signtoolOptions": {
        "sign": "./sign.js"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "guid": "36a34d7f-ced7-44f9-ba8e-c5256911e1db",
      "artifactName": "filebridge-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "filebridge-portable-${version}.${ext}"
    },
    "mac": {
      "artifactName": "filebridge-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "afterAllArtifactBuild": "./build/verify-mac-build.js"
  },
  "dependencies": {
    "dbus-next": "0.10.2"
  }
}
